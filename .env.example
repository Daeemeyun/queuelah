EXPO_PUBLIC_SUPABASE_URL=your_supabase_project_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
EXPO_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com
EXPO_PUBLIC_SENTRY_DSN=https://your_key@oXXXXXX.ingest.sentry.io/XXXXXXX

# ── Social sign-in (public OAuth client IDs only — NOT secrets) ──
# Fill these from Google Cloud Console (see app/lib/auth/CREDENTIALS_CHECKLIST.md
# §B). Secrets (web client secret, Apple .p8, Facebook app secret) go ONLY in the
# Supabase Dashboard, never in the app bundle. Apple's native flow needs no
# app-side client ID; Facebook's App ID is read from native config after prebuild.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_oauth_client_id
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_oauth_client_id
